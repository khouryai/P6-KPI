node_modules/
*.log
.DS_Store
Thumbs.db

# Real P6 exports and workbooks are commercially sensitive. Never commit them.
*.xlsx
*.xlsm
*.xls
*.csv
*.xer
*.xer.gz
!fixtures/*.xlsx
!fixtures/*.csv
!fixtures/*.tsv
!fixtures/*.xer

# The built application IS committed: the laptop it runs on has no Node and no npm,
# so dist/ and standalone/ are the delivered product. Rebuild with `npm run build:all`.
!dist/
!standalone/

# Live OneDrive storage folder, in case it is ever placed inside the repo
TC-Budget/
**/TC-Budget/
*.lock
local/

# Playwright's own output. The suite itself is committed; its reports are not.
/test-results/
/playwright-report/

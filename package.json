{
  "name": "tc-p6-budget-scurve",
  "private": true,
  "version": "0.1.0",
  "description": "T&C P6 Budget and S-Curve desktop application (local, no server, OneDrive-backed)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-standalone.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:all": "npm run build",
    "preview": "vite preview",
    "serve": "node server/serve.mjs",
    "serve:ps": "pwsh -NoProfile -File server/serve.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixture": "node scripts/build-fixture.mjs",
    "verify:workbook": "node scripts/verify-workbook.mjs",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
